                </div>
            </div>
        </div>

        <footer>
            <div class="container">
                <p>&copy; 2023 ISHE System - Ifisheco Safe, Health & Environment. Semua hak dilindungi.</p>
                <p>Sistem Pelaporan Keselamatan Kerja Pertambangan Nikel</p>
            </div>
        </footer>
    </div>

    <script>
        // Set current date and time for report form
        document.addEventListener('DOMContentLoaded', function() {
            const now = new Date();
            const timezoneOffset = now.getTimezoneOffset() * 60000;
            const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
            document.getElementById('reportDate').value = localISOTime;
        });

        // Login function
        function login() {
            const loginId = document.getElementById('loginId').value;
            const password = document.getElementById('loginPassword').value;
            
            if (loginId && password) {
                // Hide login page, show app
                document.getElementById('loginPage').style.display = 'none';
                document.getElementById('appContainer').style.display = 'block';
                
                // Set user name based on ID (in a real app, this would come from backend)
                if (loginId === 'NKL-2021-087') {
                    document.getElementById('userName').textContent = 'Ahmad Safrudin';
                } else {
                    document.getElementById('userName').textContent = 'Karyawan ' + loginId;
                }
            } else {
                alert('Harap masukkan ID karyawan dan password');
            }
        }

        // Logout function
        function logout() {
            document.getElementById('loginPage').style.display = 'flex';
            document.getElementById('appContainer').style.display = 'none';
            
            // Clear login fields
            document.getElementById('loginId').value = '';
            document.getElementById('loginPassword').value = '';
            
            // Show dashboard on next login
            showPage('dashboard');
        }

        // Show different pages
        function showPage(pageName) {
            // Hide all pages
            document.getElementById('dashboardPage').style.display = 'none';
            document.getElementById('reportFormPage').style.display = 'none';
            document.getElementById('reportsListPage').style.display = 'none';
            document.getElementById('profilePage').style.display = 'none';
            
            // Show selected page
            document.getElementById(pageName + 'Page').style.display = 'block';
            
            // Update active nav item
            const navItems = document.querySelectorAll('.nav-item');
            navItems.forEach(item => item.classList.remove('active'));
            
            // Set active based on page
            if (pageName === 'dashboard') {
                navItems[0].classList.add('active');
            } else if (pageName === 'reportForm') {
                navItems[1].classList.add('active');
            } else if (pageName === 'reportsList') {
                navItems[2].classList.add('active');
            } else if (pageName === 'profile') {
                navItems[3].classList.add('active');
            }
        }

        // Submit report form
        function submitReport(event) {
            event.preventDefault();
            
            // Get form values
            const reportType = document.querySelector('input[name="reportType"]:checked').value;
            const location = document.getElementById('location').value;
            const description = document.getElementById('incidentDescription').value;
            
            // In a real app, this would send data to a backend
            alert('Laporan berhasil dikirim! Laporan akan segera ditindaklanjuti oleh tim HSE.');
            
            // Reset form and go to dashboard
            document.getElementById('reportForm').reset();
            
            // Set current date and time again
            const now = new Date();
            const timezoneOffset = now.getTimezoneOffset() * 60000;
            const localISOTime = new Date(now - timezoneOffset).toISOString().slice(0, 16);
            document.getElementById('reportDate').value = localISOTime;
            
            showPage('dashboard');
        }
    </script>
</body>
</html>
